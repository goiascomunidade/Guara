# Porcupine wake word detection
# Get your access key at https://console.picovoice.ai
PORCUPINE_ACCESS_KEY=your-porcupine-access-key
# Download/train a .ppn keyword file for your wake word at console.picovoice.ai
PORCUPINE_KEYWORD_PATH=keywords/guara_pt_linux.ppn
# Detection sensitivity 0.0 (strict) to 1.0 (permissive)
PORCUPINE_SENSITIVITY=0.5
# Optional: path to Porcupine model file (leave empty for default)
PORCUPINE_MODEL_PATH=
# Optional: audio device index (-1 = system default)
PORCUPINE_DEVICE_INDEX=-1

# Wake word display label and stop word
GUARA_WAKE_WORD=guará
GUARA_STOP_WORD=obrigado

# LLM
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# STT (whisper = local, deepgram = cloud)
GUARA_STT=whisper
WHISPER_MODEL_SIZE=base

# TTS
GUARA_TTS=piper
PIPER_MODEL_PATH=models/pt_BR-faber-medium.onnx
